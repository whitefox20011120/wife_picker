{
  "manifest_version": 2,
  "version": "2.0.0",
  "name": "今日老婆",
  "description": "随机抽取今日老婆",
  "author": {
    "name": "whitefox",
    "url": "https://github.com/whitefox20011120"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/whitefox20011120/wife_picker"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    }
  ],
  "capabilities": [
    "config.get",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "whitefox.wife-picker",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/wife.png",
      "fallback": "image",
      "background": "#ffffff"
    }
  }
}